JUICESHOP_REPO=https://github.com/caiolamego/juice-shop-tcc
JUICESHOP_COMMIT=f915bddd82790d0f3018902d36ae9b4241a5f51f
# Provedor padrão preservado. Troque para colab para usar o notebook.
LLM_PROVIDER=openai
OPENAI_API_KEY=<preencher_com_sua_chave>
OPENAI_MODEL=gpt-4.1-mini
OPENAI_SEED=42
SEMGREP_CMD=semgrep
MAX_LLM_CALLS=400
MAX_USD=25

# Colab: selecione LLM_PROVIDER=colab acima e preencha os campos abaixo.
# Especificação: docs/historico/features/07-modelo-colab/README.md
# OPENAI_* continua exclusivo do provedor OpenAI; não use a chave OpenAI no Colab.
# URL HTTPS acessível por esta máquina, incluindo /v1 (não localhost do Colab).
COLAB_BASE_URL=https://uphold-suitor-scored.ngrok-free.dev/v1
# Token privado configurado no servidor de inferência, não a chave OpenAI.
COLAB_API_KEY=key
# Nome EXATO publicado pelo servidor em GET /v1/models.
COLAB_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct
# Manifesto local com modelo/revisão/tokenizer/quantização/template/servidor.
COLAB_MODEL_MANIFEST=config/modelos/manifesto_colab.json
COLAB_SEED=42
COLAB_TIMEOUT_S=600
COLAB_MAX_OUTPUT_TOKENS=4096
# Concorrência da inferência, independente de K (número de worktrees).
COLAB_MAX_IN_FLIGHT=1
# MAX_LLM_CALLS limita cada envio Colab, usando contador próprio em .cache/colab/.
# Custos Colab não informados ficam null; MAX_USD protege somente o provedor OpenAI.
# COLAB_API_KEY local = secret COLAB_LLM_API_KEY no notebook (não NGROK_AUTHTOKEN).
